# Wallet address to receive USDC payments
X402_WALLET=0xYOUR_WALLET_ADDRESS_HERE

# Optional: Custom facilitator URL (defaults to https://x402.org/facilitator)
# X402_FACILITATOR=https://x402.org/facilitator

# Nano address to receive XNO for tools on the nano network (word-count).
# The word-count tool cannot be paid for until this is set.
# X402_NANO_WALLET=nano_YOUR_NANO_ADDRESS_HERE

# Optional: Nano node RPC used to verify payments (defaults to https://rpc.nano.to)
# X402_NANO_RPC=https://rpc.nano.to
