{
  "name": "with-hydrogen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "xmcp build && (xmcp dev & react-router dev)",
    "build": "xmcp build && react-router build && react-router typegen && tsc --noEmit",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.cjs build/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node --import tsx --test tests/http.smoke.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/live.ts"
  },
  "dependencies": {
    "xmcp": "workspace:*",
    "zod": "^4.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5",
    "@shopify/hydrogen": "2026.10.3"
  },
  "devDependencies": {
    "@xmcp-dev/compiler": "workspace:*",
    "@types/node": "^22.19.2",
    "typescript": "^5.9.3",
    "@react-router/dev": "^8.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "vite": "^8.3.5",
    "tsx": "^4.21.0"
  }
}
