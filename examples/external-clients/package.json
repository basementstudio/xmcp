{
  "name": "External Clients",
  "private": true,
  "description": "Learn how to use external clients in xmcp",
  "keywords": [
    "clients",
    "integrations",
    "external-clients"
  ],
  "scripts": {
    "build": "xmcp build",
    "dev": "xmcp dev",
    "start": "node dist/http.js",
    "generate": "xmcp-dev-cli generate",
    "managed": "node managed-client.mjs",
    "inspect": "xmcp-dev-cli inspect local --clients discovery.clients.ts",
    "list:server": "xmcp-dev-cli list local --clients discovery.clients.ts",
    "call:server": "xmcp-dev-cli call local --clients discovery.clients.ts",
    "read:server": "xmcp-dev-cli read-resource local --clients discovery.clients.ts",
    "prompt:server": "xmcp-dev-cli get-prompt local --clients discovery.clients.ts",
    "install:preview": "xmcp-dev-cli install local --clients discovery.clients.ts --client cursor --config .cursor/mcp.json --dry-run"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.85",
    "@xmcp-dev/cli": "workspace:*",
    "xmcp": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@xmcp-dev/compiler": "workspace:*"
  }
}
