{
  "name": "with-nestjs",
  "description": "Basic NestJS server with xmcp's adapter - No authentication",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "xmcp dev & nest start --watch",
    "build": "xmcp build && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@xmcp-dev/compiler": "workspace:*",
    "typescript": "^5.9.3",
    "xmcp": "workspace:*"
  },
  "keywords": [
    "adapter",
    "nestjs",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
