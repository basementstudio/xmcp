{
  "name": "Express with Adapter",
  "private": true,
  "description": "Build a Node.js Express server with xmcp's adapter",
  "main": "dist/index.js",
  "scripts": {
    "dev": "xmcp dev & tsx watch src/index.ts",
    "build": "xmcp build && tsx src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@xmcp-dev/compiler": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "xmcp": "workspace:*"
  },
  "keywords": [
    "adapter",
    "express",
    "http"
  ],
  "author": "",
  "license": "MIT"
}
