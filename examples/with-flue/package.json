{
  "name": "with-flue",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "xmcp build",
    "start": "node --env-file=.env dist/http.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --import tsx --test tests/http.smoke.ts",
    "build:agent": "vite build",
    "dev:agent": "vite --port 3002",
    "start:agent": "node --env-file=.env agent-dist/server.mjs",
    "consume": "node --env-file=.env --import tsx scripts/consume.ts"
  },
  "dependencies": {
    "xmcp": "workspace:*",
    "zod": "^4.0.10",
    "@flue/runtime": "2.3.0",
    "@flue/sdk": "2.3.0",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@xmcp-dev/compiler": "workspace:*",
    "@types/node": "^22.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@flue/vite": "2.3.0",
    "vite": "^8.3.5"
  }
}
