{
  "name": "with-eve",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "xmcp build",
    "start": "node --env-file=.env dist/http.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --import tsx --test tests/http.smoke.ts",
    "build:agent": "eve build",
    "dev:agent": "eve dev --no-tui --port 3002",
    "start:agent": "node --env-file=.env .output/server/index.mjs"
  },
  "dependencies": {
    "xmcp": "workspace:*",
    "zod": "^4.0.10",
    "eve": "1.0.0-rc.18",
    "ai": "7.0.173"
  },
  "devDependencies": {
    "@xmcp-dev/compiler": "workspace:*",
    "@types/node": "^22.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
