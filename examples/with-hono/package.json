{
  "name": "hono-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "xmcp build && (xmcp dev & node --watch --import tsx src/server.ts)",
    "build": "xmcp build && tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev:cf": "xmcp build --cf && (xmcp dev --cf & wrangler dev)",
    "build:cf": "xmcp build --cf && tsc --noEmit && wrangler deploy --dry-run --outdir dist/worker",
    "deploy:cf": "xmcp build --cf && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "xmcp": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@xmcp-dev/compiler": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.161.0"
  }
}
