{
  "name": "tanstack-cloudflare-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TanStack MCP adapter on Cloudflare Workers",
  "scripts": {
    "dev": "xmcp build --cf && (xmcp dev --cf & vite dev)",
