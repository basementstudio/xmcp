    "xmcp": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xmcp-dev/compiler": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
