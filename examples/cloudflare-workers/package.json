{
  "name": "cloudflare-workers-example",
  "version": "0.0.1",
  "description": "Example xmcp server deployed to Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "xmcp build --cf",
    "dev": "concurrently \"xmcp dev --cf\" \"npx wrangler dev\"",
    "deploy": "npx wrangler deploy",
    "preview": "npx wrangler dev"
  },
  "dependencies": {
    "xmcp": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@xmcp-dev/compiler": "workspace:*",
    "concurrently": "^10.0.7",
    "typescript": "^5.7.2",
    "wrangler": "^4.161.0"
  },
  "keywords": [
    "adapter",
    "cloudflare-workers",
    "workers"
  ]
}
