{
  "name": "sveltekit-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "xmcp build && (xmcp dev & vite dev)",
    "build": "xmcp build && vite build && svelte-check --tsconfig ./tsconfig.json",
    "start": "node build",
    "dev:cf": "xmcp build --cf && (xmcp dev --cf & cross-env XMCP_CLOUDFLARE=1 vite dev)",
    "build:cf": "xmcp build --cf && cross-env XMCP_CLOUDFLARE=1 vite build && svelte-check --tsconfig ./tsconfig.json",
    "preview:cf": "wrangler dev",
    "deploy:cf": "pnpm build:cf && wrangler deploy"
  },
  "dependencies": {
    "xmcp": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@xmcp-dev/compiler": "workspace:*",
    "cross-env": "^7.0.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  }
}
