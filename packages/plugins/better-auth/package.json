    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "chalk": "^6.0.1",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.4.1",
    "postcss": "8.5.32",
