  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run dev:main & pnpm run dev:ui",
    "dev:main": "tsc --watch",
    "dev:ui": "cd ui && vite --config ./vite.config.mjs",
    "build": "rm -rf dist && tsc && pnpm run build:ui",
    "build:ui": "cd ui && vite build --config ./vite.config.mjs",
    "preview:ui": "cd ui && vite preview --config ./vite.config.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.23",
    "express": "^5.3.0",
    "react": "^19.3.1",
