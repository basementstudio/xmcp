{
  "name": "@xmcp-dev/compiler",
  "description": "Development compiler for xmcp",
  "version": "1.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basementstudio/xmcp"
  },
  "type": "commonjs",
  "main": "./dist/cli.js",
  "bin": {
    "xmcp-compiler": "dist/cli.js"
  },
  "exports": {
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch --tsconfig ./bundler.tsconfig.json ./bundler/index.ts",
    "build": "cross-env NODE_ENV=production tsx --tsconfig ./bundler.tsconfig.json ./bundler/index.ts",
    "test:config": "node --import tsx --test src/compiler/config/__tests__/*.test.ts src/compiler/get-bundler-config/__tests__/*.test.ts src/compiler/schema-inference/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rspack/core": "^2.3.2",
    "postcss-loader": "^8.2.1",
    "ts-checker-rspack-plugin": "^1.8.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/fs-extra": "catalog:",
    "@types/node": "^26.6.6",
    "async-retry": "^1.3.3",
    "chalk": "^6.0.1",
    "chokidar": "catalog:",
    "ci-info": "^4.5.0",
    "commander": "catalog:",
    "cross-env": "catalog:",
    "del": "^9.0.1",
    "dotenv": "^18.0.10",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.6",
    "is-docker": "^4.0.0",
    "is-wsl": "^3.1.1",
    "json5": "catalog:",
    "memfs": "^4.80.1",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "xmcp": "workspace:>=1.0.0",
    "zod": "^3.25.76 || ^4.0.0"
  }
}
