{
  "name": "@xmcp-dev/compiler",
  "description": "Development compiler for xmcp",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basementstudio/xmcp"
  },
  "type": "commonjs",
  "main": "./dist/cli.js",
  "bin": {
    "xmcp-compiler": "dist/cli.js"
  },
  "exports": {
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch --tsconfig ./bundler.tsconfig.json ./bundler/index.ts",
    "build": "cross-env NODE_ENV=production tsx --tsconfig ./bundler.tsconfig.json ./bundler/index.ts",
    "test:config": "node --import tsx --test src/compiler/config/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rspack/core": "^1.6.7",
    "postcss-loader": "^8.2.0",
    "ts-checker-rspack-plugin": "^1.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.2",
    "async-retry": "^1.3.3",
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "ci-info": "^4.3.1",
    "commander": "^11.1.0",
    "cross-env": "^7.0.3",
    "del": "^7.1.0",
    "dotenv": "^16.6.1",
    "fs-extra": "^11.3.2",
    "glob": "^11.1.0",
    "is-docker": "^4.0.0",
    "is-wsl": "^3.1.0",
    "json5": "^2.2.3",
    "memfs": "^4.51.1",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "xmcp": "workspace:>=1.0.0",
    "zod": "^3.25.76 || ^4.0.0"
  }
}
