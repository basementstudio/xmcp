{
  "compilerOptions": {
    "target": "es2017",
    "module": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true
  },
  "include": ["xmcp-env.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
